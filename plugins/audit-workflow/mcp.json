{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "audit-workflow": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/mcp/audit_mcp_server.py"
      ],
      "env": {
        "AUDIT_PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "AUDIT_REQUIRE_EXPLICIT_ROOT": "1"
      }
    }
  }
}
