{
  "description": "Codex audit lifecycle integration using the shared audit guard.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/audit_guard.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/audit_guard.py\" pre-tool-use",
            "timeout": 5
          }
        ],
        "matcher": "^(Bash|PowerShell|exec_command|shell_command|apply_patch|Edit|Write|MultiEdit)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/audit_guard.py\" post-tool-use",
            "timeout": 15
          }
        ],
        "matcher": "^(Bash|PowerShell|exec_command|shell_command|apply_patch|Edit|Write|MultiEdit)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/audit_guard.py\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
